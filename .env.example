# ------------------------------------------------------------------
# Enterprise AI Invoice & Expense Automation: environment template
# Copy to `.env` and fill in. Never commit the real `.env`.
# API keys are stored as n8n credentials (see README §Setup); the
# values below are the reference copy your team fills in once.
# ------------------------------------------------------------------

# --- n8n instance (self-hosted Docker) ---
N8N_HOST=n8n.yourcompany.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.yourcompany.com/
GENERIC_TIMEZONE=UTC
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- OCR: Mistral Document AI ---
# Credential: "Enterprise AI Invoice · Mistral API" (Header Auth)
#   Name:  Authorization
#   Value: Bearer ${MISTRAL_API_KEY}
MISTRAL_API_KEY=

# --- LLM: Google Gemini ---
# Credential: "Enterprise AI Invoice · Google Gemini API"
GOOGLE_GEMINI_API_KEY=

# --- Google Workspace OAuth (Gmail, Drive, Sheets) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Slack ---
# Credential: "Enterprise AI Invoice · Slack" (Bot token, scopes: chat:write, channels:read)
SLACK_BOT_TOKEN=xoxb-

# --- Pipeline settings (mirror these in the "Config · Pipeline Settings" node) ---
APPROVAL_THRESHOLD=5000
CONFIDENCE_THRESHOLD=0.85
AMOUNT_TOLERANCE=0.02
REQUIRE_TAX_ID=true
DEFAULT_CURRENCY=USD
SLACK_CHANNEL=#ap-invoices
AP_TEAM_EMAIL=accounts-payable@yourcompany.com
GOOGLE_SHEET_ID=
DRIVE_ARCHIVE_FOLDER_ID=
GMAIL_PROCESSED_LABEL_ID=
